<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Monitoreo de uso: se concede manualmente en Ajustes > Acceso a datos de uso -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Mostrar sobre otras apps: permite abrir la pausa de fricción encima de la red social -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Servicio en primer plano del monitoreo -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reanudar el monitoreo al reiniciar el dispositivo -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Pedir exención de la optimización de batería -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Paquetes que la app necesita poder consultar (Android 11+) -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.twitter.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.instagram.barcelona" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:showWhenLocked="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Servicio en primer plano que detecta la apertura de redes sociales -->
      <service
        android:name=".usagestats.MonitoreoService"
        android:exported="false"
        android:foregroundServiceType="specialUse"
        android:stopWithTask="false">
        <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Monitoreo de uso de redes sociales para apoyo conductual (estudio académico)" />
      </service>

      <!-- Reanuda el monitoreo y los recordatorios tras reiniciar el dispositivo -->
      <receiver
        android:name=".usagestats.ArranqueReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        </intent-filter>
      </receiver>

      <!-- Recordatorio local del check-in nocturno -->
      <receiver
        android:name=".notificaciones.RecordatorioReceiver"
        android:exported="false">
        <intent-filter>
            <action android:name="com.umg.scrollapp.RECORDATORIO_CHECKIN" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
